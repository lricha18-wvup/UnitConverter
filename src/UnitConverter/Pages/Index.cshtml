@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <form method="get" action="/Conversions">
        <label for="conversionType" class="form-label">Conversion Type</label>
        <select id="conversionType"
                name="Conversion.ConversionType"
                class="form-select">
            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">@conversion.Value</option>
            }
        </select>

        <label for="input" class="form-label">Value to Convert</label>
        <input id="input"
               name="Conversion.Input"
               type="text"
               class="form-control" />

        <button type="submit" class="btn btn-primary">Convert</button>
    </form>


</div>


